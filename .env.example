# Every environment variable Lift uses, with what it is for.
# Development: `pnpm env:init` copies this file to .env and generates each value marked __generate__.
# Production: each VM keeps its values in /opt/lift/.env (mode 600). Never commit real values.

# ── All apps ────────────────────────────────────────────────────────────────────
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Interface the servers listen on: 127.0.0.1 on a laptop, 0.0.0.0 inside containers (the default
# when NODE_ENV=production).
HOST=127.0.0.1

# ── Ports (containers use the same numbers in production) ──────────────────────
API_PORT=4000
AGENT_PORT=4100
COLLAB_PORT=4200
MCP_PORT=4300

# ── URLs ────────────────────────────────────────────────────────────────────────
# Where people open the dashboard; the API builds OAuth callbacks and links from it.
PUBLIC_URL=http://localhost:3000
# Deployed apps get {service}-{project}.{APPS_DOMAIN}; *.localhost resolves to your own machine.
APPS_DOMAIN=apps.localhost
# Where the API listens: used by the web app's development proxy and by the agent service.
API_URL=http://localhost:4000
# Where the API reaches the agent service.
AGENT_URL=http://localhost:4100

# ── Data (from infra/compose/dev.yml) ──────────────────────────────────────────
DATABASE_URL=postgres://lift:lift@localhost:5432/lift
REDIS_URL=redis://localhost:6379

# ── Secrets (pnpm env:init generates these) ────────────────────────────────────
# Signs browser session cookies.
SESSION_SECRET=__generate__
# 32 random bytes, base64. Encrypts every *_enc column (AES-256-GCM). Lose it and stored secrets
# can't be read back.
ENCRYPTION_KEY=__generate__
# Shared by the worker and the API's internal routes.
WORKER_TOKEN=__generate__
# Shared by the agent service and the API; starts with lift_svc_.
AGENT_SERVICE_TOKEN=__generate__
# Signs the live editor's collab tokens (HS256); shared by the API and the collab server.
COLLAB_SECRET=__generate__

# ── GitHub OAuth app (each developer registers their own) ──────────────────────
# github.com → Settings → Developer settings → OAuth Apps → New OAuth App
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub logins allowed to sign in (case doesn't matter). Empty lets anyone who
# can use your OAuth app sign in, which is fine on a laptop; production requires a list.
ALLOWED_GITHUB_LOGINS=

# ── AI service ──────────────────────────────────────────────────────────────────
# An Anthropic API key with a monthly spending cap. Only the agent service reads it. Without it,
# "Continue with AI" answers that the assistant isn't set up.
ANTHROPIC_API_KEY=
# Input tokens a project, or a user planning a repo, may spend per UTC day (default 300000).
AGENT_DAILY_TOKEN_BUDGET=

# ── Web (inlined into the browser bundle at build time: never put a secret here) ──
NEXT_PUBLIC_COLLAB_URL=ws://localhost:4200
# 1 runs the dashboard against mock data (apps/web/src/mocks) instead of the API.
NEXT_PUBLIC_USE_MOCKS=0

# ── Worker ──────────────────────────────────────────────────────────────────────
# The API as the worker reaches it (the control plane's private IP in production).
CONTROL_API_URL=http://localhost:4000
# BuildKit daemon (`pnpm stack:up` starts it).
BUILDKIT_HOST=tcp://localhost:1234
# lift-pg's superuser, which creates and drops users' databases (`pnpm stack:up` starts lift-pg).
LIFT_PG_URL=postgres://postgres:lift@localhost:5433/postgres
# Optional. Where builds clone repos: a lift-builds folder in your temp directory unless set.
# BUILD_DIR=
# Optional. Builds at a time (1 to 4); builds are CPU-bound.
# BUILD_CONCURRENCY=1

# ── CLI and MCP server ──────────────────────────────────────────────────────────
# The Lift API they talk to.
LIFT_API_URL=http://localhost:4000
# A personal API token (lift_pat_…) for the MCP server. The CLI keeps its own in ~/.lift/config.json.
LIFT_TOKEN=
