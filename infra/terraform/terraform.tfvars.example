# Copy to terraform.tfvars (git-ignored) and fill in. None of these values is a secret.
domain            = "example.dev"     # the zone on Cloudflare
alert_emails      = ["you@example.com"]
github_repository = "Louisa-Lois/lift" # exact case, as in the repo URL
# gh api repos/Louisa-Lois/lift/actions/oidc/customization/sub --jq .sub_claim_prefix
github_oidc_sub_prefix = "repo:Louisa-Lois@231678881/lift@1460281207"

# Defaults, shown so you know they exist:
# region                      = "eu-west-1"
# aws_profile                 = "lift"
# worker_instance_type        = "t3.large"   # t3.xlarge in demo week
# monthly_budget_usd          = 50
# stop_instances_at_usd       = 120
# github_deploy_context       = "ref:refs/heads/main" # or environment:production; deploy.yml must match
# create_github_oidc_provider = true         # false if the account already has GitHub's OIDC provider
