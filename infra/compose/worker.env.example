# Keys for /opt/lift/.env on the WORKER VM. Never commit real values.
# The file already exists (cloud-init creates it empty, mode 600, owner root). Open a shell with
# `terraform output shell`, then: sudo nano /opt/lift/.env
# CONTROL_PRIVATE_IP and DOMAIN are not here: cloud-init wrote them to /opt/lift/host.env.

# ── Copied from the control plane's /opt/lift/.env (must match exactly) ───────────────────────
REDIS_PASSWORD=
WORKER_TOKEN=

# ── Generated on this VM ───────────────────────────────────────────────────────────────────────
# openssl rand -hex 32   Superuser password for lift-pg, the shared Postgres for users' databases.
LIFT_PG_PASSWORD=

# ── From outside services ──────────────────────────────────────────────────────────────────────
# The same Cloudflare DNS token as the control plane (Zone Read + DNS Edit on the one zone).
CF_DNS_API_TOKEN=

# ── Optional ───────────────────────────────────────────────────────────────────────────────────
# Only if the lift-* packages on ghcr.io are private (see control.env.example).
GHCR_PULL_USER=
GHCR_PULL_TOKEN=
