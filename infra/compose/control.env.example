# Keys for /opt/lift/.env on the CONTROL PLANE VM. Never commit real values.
# The file already exists (cloud-init creates it empty, mode 600, owner root). Open a shell with
# `terraform output shell`, then: sudo nano /opt/lift/.env
# Generate each random value on the VM itself, so it never passes through your laptop.
# Facts like DOMAIN and PRIVATE_IP are not here: cloud-init wrote them to /opt/lift/host.env.

# ── Generated (run each command on the VM, paste the output) ───────────────────────────────────
# openssl rand -hex 32   (hex only: these two go inside URLs)
POSTGRES_PASSWORD=
# openssl rand -hex 32   The worker's /opt/lift/.env needs this same value.
REDIS_PASSWORD=
# openssl rand -hex 32
SESSION_SECRET=
# openssl rand -base64 32   (exactly 32 bytes, base64). Lose it and stored variables can't be decrypted.
ENCRYPTION_KEY=
# openssl rand -hex 32   The worker's /opt/lift/.env needs this same value.
WORKER_TOKEN=
# echo "lift_svc_$(openssl rand -base64 24 | tr '+/' '-_')"   lift_svc_ plus exactly 32 base64url
# characters (SERVICE_TOKEN_PATTERN in packages/shared), the same format pnpm env:init makes.
AGENT_SERVICE_TOKEN=
# openssl rand -hex 32
COLLAB_SECRET=

# ── From outside services ──────────────────────────────────────────────────────────────────────
# Production GitHub OAuth app: github.com → Settings → Developer settings → OAuth Apps → New
#   Homepage URL:               https://app.{domain}
#   Authorization callback URL: https://app.{domain}/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Anthropic key with a monthly spending cap. Only the agent container receives it.
ANTHROPIC_API_KEY=
# Cloudflare API token for Traefik's DNS-01 challenge: Zone → Zone → Read and Zone → DNS → Edit,
# on the one zone only. The worker uses the same token.
CF_DNS_API_TOKEN=

# ── Optional ───────────────────────────────────────────────────────────────────────────────────
# Only if the lift-* packages on ghcr.io are private: a classic GitHub token with read:packages
# only, and the GitHub username that owns it. Leave both empty when the packages are public.
GHCR_PULL_USER=
GHCR_PULL_TOKEN=
# Set to mcp once apps/mcp ships its HTTP transport (AI-11) to start the mcp container.
COMPOSE_PROFILES=
