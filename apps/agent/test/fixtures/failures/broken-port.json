    "package.json": "{\n  \"name\": \"lift-broken-port\",\n  \"version\": \"1.0.0\",\n  \"private\": true,\n  \"description\": \"A seeded failure for Lift's autofix demo: the app listens on 8080 whatever PORT says.\",\n  \"scripts\": { \"start\": \"node server.js\" },\n  \"engines\": { \"node\": \">=20\" }\n}\n",
    "server.js": "const http = require(\"node:http\");\n\n// The seeded mistake: the port is hard-coded, so the app ignores the PORT Lift passes it.\nconst port = 8080;\n\nhttp\n  .createServer((_request, response) => {\n    response.writeHead(200, { \"content-type\": \"text/plain\" });\n    response.end(\"lift-broken-port is up.\\n\");\n  })\n  .listen(port, () => console.log(`Listening on port ${port}`));\n"
