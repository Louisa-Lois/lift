{
  "name": "@lift/api",
  "version": "0.0.0",
  "private": true,
  "description": "Lift REST API: auth, projects, services, deployments, logs, live events and the worker's internal API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/swagger": "9.9.5",
    "@lift/db": "workspace:*",
    "@lift/shared": "workspace:*",
    "bullmq": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "catalog:",
    "postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@lift/config": "workspace:*",
    "@types/node": "catalog:",
    "openapi-types": "12.1.3",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
