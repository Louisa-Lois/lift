{
  "name": "@lift/collab",
  "version": "0.0.0",
  "private": true,
  "description": "Hocuspocus server for the live editor",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hocuspocus/server": "^4.8.0",
    "@lift/shared": "workspace:*",
    "y-protocols": "^1.0.7",
    "yjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@lift/config": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
