{
  "name": "@lift/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Runs on the worker VM: builds images, runs containers, ships logs and metrics, provisions databases",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@lift/shared": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@lift/config": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
